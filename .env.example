# =============================================================================
# LIBRERÍA UNIVERSAL - PLANTILLA DE CONFIGURACIÓN DE SEGURIDAD (.env.example)
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a `.env` (`cp .env.example .env`).
# 2. Genera claves criptográficas seguras (ej: `openssl rand -hex 32`).
# 3. NUNCA comitees el archivo `.env` en repositorios públicos o privados.
# =============================================================================

# ENTORNO Y PUERTO DEL SERVIDOR
NODE_ENV=production
PORT=3000
APP_URL=https://libreriauniversal.vercel.app

# SEGURIDAD CRIPTOGRÁFICA (AES-256-GCM)
# Clave hexadecimal de 32 bytes (64 caracteres hex) para cifrado a nivel de aplicación
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AUTENTICACIÓN JWT & SESIÓN
# Secreto para firmar tokens JWT (mínimo 32 caracteres de alta entropía)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars_123!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=secure_cookie_secret_salt_9876543210_change_me!

# BASE DE DATOS / SUPABASE (ARQUITECTURA DE CLAVES SEGREGADAS)
# Clave PÚBLICA (Anon Key) - ÚNICA permitida en el Frontend / Clientes
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon_public_key_example

# Clave PRIVADA DE ADMINISTRADOR (Service Role Key) - ESTRICTAMENTE PRIVADA EN EL SERVIDOR
# NUNCA DEBE LLEGAR AL NAVEGADOR
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role_private_server_only_key

# CONEXIÓN DIRECTA A POSTGRESQL (Prepared Statements con SSL forzado)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres?sslmode=require

# PROTECCIÓN CONTRA BOTS (Cloudflare Turnstile / Google reCAPTCHA)
# Clave secreta para verificación en el servidor
TURNSTILE_SECRET_KEY=0x4AAAAAAAx_example_turnstile_secret_key_server_only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx_example_turnstile_site_key_client

# CONTROL DE SUBIDA DE ARCHIVOS
MAX_FILE_SIZE_MB=5
UPLOAD_DIRECTORY=./secure_uploads

# CORS (Dominios autorizados explícitos)
ALLOWED_ORIGINS=https://libreriauniversal.vercel.app,http://localhost:3000

# CREDENCIALES DE ADMINISTRADOR (LIBRERÍA UNIVERSAL)
ADMIN_EMAIL=libu.impresiones@gmail.com
ADMIN_PASSWORD=change_this_to_a_secure_random_password_min_16_chars
