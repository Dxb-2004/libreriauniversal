<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Librería Universal | Imprenta, Gráfica y Librería en Valentín Alsina</title>
  <meta name="description" content="Librería Universal en Valentín Alsina. Impresiones láser ByN y color, diseño gráfico, plastificados, encuadernaciones, confección de sellos y artículos de librería comercial y escolar.">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              cyan: '#00A3E0',
              magenta: '#E5007D',
              yellow: '#FFD100',
              purple: '#7C3AED',
              dark: '#0B0F19',
              card: '#111827',
              border: '#1F2937'
            }
          },
          fontFamily: {
            sans: ['Poppins', 'Inter', 'system-ui', 'sans-serif'],
            display: ['Poppins', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
            script: ['Dancing Script', 'cursive'],
            impact: ['Oswald', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Google Fonts Oficiales para Catálogo de Sellos e Interfaz -->
