                  <span class="text-xs text-slate-400 block">Lunes a Viernes</span>
                </div>
              </div>

              <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-start gap-3">
                <span class="text-pink-400 text-base">✉️</span>
                <div>
                  <span class="text-slate-400 text-xs block">Correo Electrónico:</span>
