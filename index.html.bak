  <!-- =========================================================================
       B. HERO SECTION (PORTADA LIBRERÍA UNIVERSAL)
       ========================================================================= -->
  <section id="inicio" class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
    <div class="absolute top-0 right-0 -mr-24 -mt-24 w-96 h-96 rounded-full bg-purple-600/10 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -ml-24 -mb-24 w-96 h-96 rounded-full bg-cyan-600/10 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Textos del Hero -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <!-- Badge superior con ubicación -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-slate-700 shadow-sm">
            <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span class="text-xs font-bold text-slate-200 tracking-wide">Valentín Alsina &bull; Imprenta, Sellos & Librería</span>
          </div>

          <!-- Título principal -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.12]">
            Librería Comercial / Escolar, <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-cyan-400 to-amber-300">Impresiones y Soluciones Gráficas.</span>
          </h1>

          <!-- Subtítulo -->
          <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
            Rapidez, máxima calidad de impresión y atención personalizada en Valentín Alsina. Impresiones, plastificados, encuadernaciones, diseño de sellos a medida y artículos de librería para particulares, colegios y empresas.
          </p>

          <!-- Botones de Acción (CTA) -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a href="#cotizador-sellos" 
               class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-sm sm:text-base bg-cyan-600 hover:bg-cyan-500 text-white shadow-lg shadow-cyan-600/30 hover:shadow-cyan-600/50 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
              <span>Diseñar mi Sello Ahora</span>
            </a>

            <a href="https://wa.me/5491126097125?text=Hola%20Librer%C3%ADa%20Universal!%20Quiero%20hacer%20una%20consulta" target="_blank"
               class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-sm sm:text-base bg-slate-900 hover:bg-slate-800 text-white border border-slate-700 shadow-sm transition-all flex items-center justify-center gap-2">
              <svg class="w-5 h-5 text-emerald-400 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.174.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/>
              </svg>
              <span>Escribir por WhatsApp</span>
            </a>
          </div>

          <!-- Métricas de confianza -->
          <div class="pt-6 grid grid-cols-3 gap-4 border-t border-slate-800 max-w-lg mx-auto lg:mx-0">
            <div>
              <div class="text-xl sm:text-2xl font-black text-white">V. Alsina</div>
