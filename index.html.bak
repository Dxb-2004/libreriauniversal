<body class="bg-slate-950 text-slate-100 antialiased selection:bg-cyan-500 selection:text-white">

  <!-- Barra Superior de Aviso y Horarios -->
  <div class="bg-gradient-to-r from-purple-950 via-slate-950 to-cyan-950 border-b border-slate-800 text-xs py-2.5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-slate-300">
      <div class="flex items-center gap-2 text-slate-300 whitespace-nowrap">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span><strong class="text-white">Horarios:</strong> 9:30 a 13:15 y 16:00 a 19:30 hs</span>
      </div>
      <div class="flex items-center gap-1.5 text-amber-300 font-semibold bg-amber-950/40 px-3.5 py-1 rounded-full border border-amber-800/60 shadow-sm text-[11px] sm:text-xs">
        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
        </svg>
        <span>¡Hola! No recibimos llamadas, solo mensajes de WhatsApp</span>
      </div>
      <div class="flex items-center gap-1.5 text-slate-300 text-xs whitespace-nowrap">
        <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Av. Pte. Tte. Gral. J. D. Perón 3502, V. Alsina</span>
      </div>
    </div>
  </div>

  <!-- Barra Decorativa CMYK / Universal -->
