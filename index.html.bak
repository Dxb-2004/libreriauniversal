  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amatic+SC:wght@700&family=Archivo+Narrow:wght@700&family=Arvo:wght@700&family=Barlow:wght@600&family=Bebas+Neue&family=Courier+Prime:wght@700&family=Courgette&family=Dancing+Script:wght@700&family=Fredoka:wght@600;700&family=Henny+Penny&family=Inter:wght@300;400;500;600;700&family=Kalam:ital,wght@1,700&family=Kaushan+Script&family=Lemon&family=Orbitron:wght@700&family=Patrick+Hand&family=Pompiere&family=Poppins:wght@300;400;500;600;700;800&family=Satisfy&family=Varela+Round&display=swap" rel="stylesheet">

  <!-- CDNFonts para fuentes específicas de catálogo -->
  <link href="https://fonts.cdnfonts.com/css/hobo-std" rel="stylesheet">
  <link href="https://fonts.cdnfonts.com/css/trashhand" rel="stylesheet">
  <link href="https://fonts.cdnfonts.com/css/script-mt-bold" rel="stylesheet">
  <link href="https://fonts.cdnfonts.com/css/always-in-my-heart" rel="stylesheet">
  <link href="https://fonts.cdnfonts.com/css/birds-of-paradise" rel="stylesheet">
