        <!-- Tarjeta Perfil Oficial en el Hero -->
        <div class="lg:col-span-5">
          <div class="relative mx-auto max-w-md bg-slate-900/90 rounded-3xl p-6 sm:p-7 shadow-2xl border border-slate-800">
            <!-- Header de tarjeta -->
            <div class="flex items-center gap-3.5 pb-4 border-b border-slate-800">
              <img src="img/logo-libreria-universal.png" alt="Logo Librería Universal" class="w-14 h-14 rounded-full object-contain bg-slate-950 border-2 border-slate-700 shadow-md">
              <div>
                <h3 class="text-base font-black text-white">Librería Universal</h3>
