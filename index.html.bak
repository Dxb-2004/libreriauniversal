  <!-- =========================================================================
       MODAL LIGHTBOX: CATÁLOGOS VISUALES COMPLETOS (DIBUJOS 1-168, DOCENTE CDC-8)
       ========================================================================= -->
  <div id="catalog-lightbox-modal" class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md hidden items-center justify-center p-3 sm:p-6 transition-all duration-300">
    <div class="bg-slate-900 border border-slate-700 w-full max-w-4xl max-h-[90vh] rounded-3xl shadow-2xl flex flex-col overflow-hidden">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-6 border-b border-slate-800 flex items-center justify-between gap-4 bg-slate-950/60">
        <div>
          <span class="text-[11px] font-extrabold uppercase tracking-wider text-cyan-400 bg-cyan-950 border border-cyan-800 px-2 py-0.5 rounded">Catálogos Oficiales</span>
          <h3 class="text-base sm:text-xl font-black text-white mt-1">Explorador de Dibujos & Sellos Docentes</h3>
        </div>
        <button type="button" id="btn-close-catalog-modal" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center font-bold text-lg transition">
          ✕
        </button>
      </div>

      <!-- Modal Tabs & PDF Download Links -->
      <div class="px-4 sm:px-6 pt-3 pb-2 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3 bg-slate-900">
        <!-- Tabs -->
        <div class="flex items-center gap-2" id="modal-tabs">
          <button type="button" data-modal-tab="drawings" class="modal-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-600 text-white shadow transition">
            🧸 Dibujos del Catálogo (1 al 168)
          </button>
          <button type="button" data-modal-tab="teacher" class="modal-tab-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
            👩‍🏫 Catálogo Docente CDC-8
          </button>
        </div>

        <!-- PDF Direct Links -->
        <div class="flex items-center gap-2 text-xs">
          <a href="catalogos/dibujitos-sellos-infantiles.pdf" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-purple-950 text-purple-300 border border-purple-800 hover:bg-purple-900 hover:text-white font-semibold transition">
            <span>📥 PDF Dibujos 1 al 168</span>
          </a>
          <a href="catalogos/catalogo-docente-cdc8.pdf" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-cyan-950 text-cyan-300 border border-cyan-800 hover:bg-cyan-900 hover:text-white font-semibold transition">
            <span>📥 PDF Docente CDC-8 (19 pág.)</span>
          </a>
        </div>
      </div>

      <!-- Modal Search Bar -->
      <div class="p-4 sm:px-6 bg-slate-950/40 border-b border-slate-800 flex items-center gap-3">
        <div class="relative flex-1">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">🔍</span>
          <input type="text" id="modal-search-input" placeholder="Buscar por número o palabra clave (ej: Messi, AFA, Stitch, Capybara, 12M, T25...)" class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-slate-950 text-white border border-slate-700 rounded-xl focus:ring-2 focus:ring-cyan-500 outline-none placeholder-slate-500">
        </div>
        <span id="modal-items-count" class="text-xs text-slate-400 font-mono whitespace-nowrap">Cargando...</span>
      </div>

      <!-- Barra de Filtros Rápidos de Colecciones Docentes (Pills) -->
      <div id="modal-teacher-filters" class="hidden px-4 sm:px-6 py-2.5 bg-slate-950/70 border-b border-slate-800 overflow-x-auto catalog-scroll whitespace-nowrap gap-2 items-center">
        <!-- Generado dinámicamente en app.js -->
      </div>

      <!-- Modal Interactive Grid -->
      <div class="p-4 sm:p-6 overflow-y-auto max-h-[60vh] catalog-scroll bg-slate-950/60">
        <div id="modal-grid-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          <!-- Inyectado por JS -->
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-3 sm:p-4 bg-slate-950 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
        <span>💡 <strong>Consejo:</strong> Hacé clic en cualquier diseño para seleccionarlo en tu sello automáticamente.</span>
        <button type="button" id="btn-modal-close-footer" class="px-4 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold transition">
          Cerrar
        </button>
      </div>

    </div>
  </div>

