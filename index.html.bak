        <div class="hidden sm:flex items-center gap-3 flex-shrink-0">
          <a href="https://wa.me/5491126097125?text=Hola%20Librer%C3%ADa%20Universal!%20Quiero%20pedir%20un%20presupuesto" target="_blank"
