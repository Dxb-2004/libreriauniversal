        <!-- Logo Oficial de Librería Universal (Más grande y destacado) -->
        <a href="#inicio" class="flex items-center gap-4 group flex-shrink-0">
          <img src="img/logo-libreria-universal.png" alt="Logo Librería Universal" 
               class="w-14 h-14 sm:w-16 sm:h-16 lg:w-20 lg:h-20 rounded-full object-contain bg-slate-900 border-2 border-slate-700/90 group-hover:border-cyan-400 group-hover:scale-105 transition-all shadow-xl">
          <div class="flex flex-col">
